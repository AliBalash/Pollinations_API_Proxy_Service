# -------------------------------
# Pollinations_API_Proxy_Service
# -------------------------------

# App runtime
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_DOCS_ENABLED=true
APP_REQUEST_TIMEOUT_SEC=120

# Optional YAML config override
# APP_CONFIG_FILE=config/config.yml

# Pollinations upstream
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_DEFAULT_IMAGE_MODEL=flux

# API keys:
# - Preferred: comma-separated pool for key rotation/failover
# - Fallback: single key
# If POLLINATIONS_API_KEYS is set, POLLINATIONS_API_KEY is ignored.
POLLINATIONS_API_KEYS=sk_key_1,sk_key_2,sk_key_3
# POLLINATIONS_API_KEY=sk_single_key

# Proxy routing
# Keep false unless your server should force outbound traffic via local proxy.
POLLINATIONS_USE_PROXY_2080=false
POLLINATIONS_PROXY_2080_URL=socks5://127.0.0.1:2080

# Optional alias for proxy URL env name (supported by app config loader)
POLLINATIONS_PROXY_URL=

# If true, httpx honors HTTP(S)_PROXY/ALL_PROXY from environment.
POLLINATIONS_TRUST_ENV_PROXY=false

# Retry and key failover behavior
POLLINATIONS_MAX_ATTEMPTS_PER_REQUEST=6
POLLINATIONS_RETRY_STATUS_CODES=402,429,500,502,503,504
POLLINATIONS_RETRY_BACKOFF_SEC=0.35
POLLINATIONS_KEY_COOLDOWN_SEC=20

# Default image request normalization (for /v1/images/generations)
IMAGE_DEFAULT_N=1
IMAGE_DEFAULT_SIZE=1024x1024
IMAGE_DEFAULT_QUALITY=medium
IMAGE_DEFAULT_RESPONSE_FORMAT=b64_json

# Admin/API panel endpoints
ADMIN_ENABLED=true
ADMIN_REQUIRE_TOKEN=true
ADMIN_TOKEN=replace_with_strong_token
ADMIN_HEADER_NAME=x-admin-token
ADMIN_MODELS_CACHE_TTL_SEC=180
